{
  "version": 8,
  "name": "Minimal Light",
  "metadata": {
    "description": "Minimal light MapLibre style based on OpenFreeMap/OpenMapTiles sources."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": {
        "background-color": "#f0f0f0"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#e3e4e0",
        "fill-opacity": 0.78
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "grass"],
      "paint": {
        "fill-color": "#e8e8e4",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#dedfdc",
        "fill-opacity": 0.82,
        "fill-outline-color": "#d0d2cd"
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "maxzoom": 15,
      "filter": ["==", ["get", "class"], "residential"],
      "paint": {
        "fill-color": "#f0f0ed",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse_public",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "class"],
        ["school", "hospital", "cemetery", "pitch"],
        true,
        false
      ],
      "paint": {
        "fill-color": "#ecece8",
        "fill-opacity": 0.52
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "fill-color": "#cfd4d7"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c4ccd1",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 11, 0.6, 15, 1.6, 18, 5],
        "line-opacity": 0.9
      }
    },
    {
      "id": "tunnel_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "tunnel"],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4d4d0",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6, 1, 12, 3, 16, 10, 20, 28],
        "line-opacity": 0.4
      }
    },
    {
      "id": "tunnel",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "tunnel"],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f0f0ed",
        "line-dasharray": [2, 1.5],
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6, 0.3, 12, 1.5, 16, 6, 20, 22],
        "line-opacity": 0.55
      }
    },
    {
      "id": "road_minor_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["minor", "service", "track"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fafafa",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 0.8, 16, 4, 20, 16],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 0.65]
      }
    },
    {
      "id": "road_motorway_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["motorway", "trunk"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fafafa",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.7, 12, 3, 16, 12, 20, 30],
        "line-opacity": 1
      }
    },
    {
      "id": "road_path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["path", "pedestrian"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f2f2ef",
        "line-dasharray": [1, 0.8],
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 15, 0.7, 20, 8],
        "line-opacity": 0.65
      }
    },
    {
      "id": "road_cycleway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["cycleway"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#dde4e6",
        "line-dasharray": [2, 1.2],
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 14, 0.6, 18, 2.5],
        "line-opacity": 0.7
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["minor", "service", "track"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 0.5, 14, 1.5, 17, 5, 20, 14],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 0.92]
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["motorway", "trunk"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.3, 12, 1.8, 16, 8, 20, 26],
        "line-opacity": 1
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["primary"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6, 0.2, 12, 1.4, 16, 6, 20, 22],
        "line-opacity": 0.98
      }
    },
    {
      "id": "road_secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["get", "brunnel"], ["bridge", "tunnel"], false, true],
        ["match", ["get", "class"], ["secondary", "tertiary"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6, 0.15, 12, 1.1, 16, 5, 20, 20],
        "line-opacity": 0.95
      }
    },
    {
      "id": "bridge_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "bridge"],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track", "path", "pedestrian"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b8b8b4",
        "line-width": [
          "interpolate",
          ["exponential", 1.2],
          ["zoom"],
          10,
          1,
          14,
          3,
          16,
          8,
          20,
          24
        ],
        "line-opacity": 0
      }
    },
    {
      "id": "bridge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "bridge"],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track", "path", "pedestrian"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fbfbf8",
        "line-width": [
          "interpolate",
          ["exponential", 1.2],
          ["zoom"],
          10,
          0.4,
          14,
          1.6,
          16,
          5,
          20,
          20
        ],
        "line-opacity": 0.95
      }
    },
    {
      "id": "bridge_outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "bridge"],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false]
      ],
      "paint": {
        "line-color": "#8f8f8a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.4, 16, 0.8, 20, 1.2],
        "line-offset": ["interpolate", ["linear"], ["zoom"], 13, 1.2, 16, 3, 20, 8],
        "line-opacity": 0
      }
    },
    {
      "id": "bridge_outline_opposite",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "bridge"],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false]
      ],
      "paint": {
        "line-color": "#8f8f8a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.4, 16, 0.8, 20, 1.2],
        "line-offset": ["interpolate", ["linear"], ["zoom"], 13, -1.2, 16, -3, 20, -8],
        "line-opacity": 0
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#cfcfcb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.4, 18, 1.4],
        "line-opacity": 0.48
      }
    },
    {
      "id": "rail_bridge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "bridge"],
        ["match", ["get", "class"], ["rail", "transit"], true, false]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b8b4ae",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 2, 16, 6, 20, 12],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0, 13, 0.7]
      }
    },
    {
      "id": "rail_bridge_ties",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "bridge"],
        ["match", ["get", "class"], ["rail", "transit"], true, false]
      ],
      "layout": {
        "line-cap": "butt"
      },
      "paint": {
        "line-color": "#d0cdc8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 3, 18, 10],
        "line-dasharray": [0.2, 1.6],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15, 0.6]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 10,
      "paint": {
        "fill-color": "#e2e2df",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.28, 17, 0.48, 19, 0.68],
        "fill-outline-color": "rgba(0, 0, 0, 0)"
      }
    },
    {
      "id": "boundary_admin",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": [
        "all",
        ["<=", ["get", "admin_level"], 6],
        ["!=", ["get", "maritime"], 1]
      ],
      "paint": {
        "line-color": "#c9c9c5",
        "line-dasharray": [1, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 11, 1.2],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.25, 10, 0.55]
      }
    },
    {
      "id": "water_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 13],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#6f7a80",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 17,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
        ["<=", ["get", "rank"], 3]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-width": 8,
        "text-offset": [0, 0.6],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#737373",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1,
        "text-opacity": 0.72
      }
    },
    {
      "id": "highway_name_major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 11, 16, 12]
      },
      "paint": {
        "text-color": "#6c6c68",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1,
        "text-opacity": 0.78
      }
    },
    {
      "id": "highway_name_minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["minor", "service", "track"], true, false]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 10, 18, 12]
      },
      "paint": {
        "text-color": "#7c7c78",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1,
        "text-opacity": 0.72
      }
    },
    {
      "id": "place_other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["city", "town", "village"], false, true],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 9, 13, 11],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#686864",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1,
        "text-opacity": 0.75
      }
    },
    {
      "id": "place_village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": ["==", ["get", "class"], "village"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 13, 12],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#545450",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1
      }
    },
    {
      "id": "place_town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 6,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#444440",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 9, 18],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#333331",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place_country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 9,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uk"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 16],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#333331",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1.4
      }
    }
  ]
}
